# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# API
PORT=3001
API_BASE_URL=http://localhost:3001

# Sessões (API e web precisam do MESMO valor; mínimo 32 caracteres)
# Gere com: openssl rand -base64 48
AUTH_SECRET=
# Único e-mail que pode acessar /adicionar (só a API usa)
ADMIN_EMAIL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Resend
RESEND_API_KEY=seu_token_resend
RESEND_FROM_EMAIL="DC Absoluto BR <noreply@dc-absoluto-br.com.br>"

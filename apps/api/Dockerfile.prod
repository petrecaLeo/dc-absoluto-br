FROM oven/bun:1.1-alpine

RUN apk add --no-cache nodejs npm && npm install -g pnpm

WORKDIR /app

# Workspace setup
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-schemas/package.json ./packages/shared-schemas/

# Install deps
RUN pnpm install --frozen-lockfile

# Copy source
COPY apps/api ./apps/api
COPY packages ./packages

WORKDIR /app/apps/api

# Depois do install (que precisa das devDependencies) e antes do build: o bun build embute o valor de
# process.env.NODE_ENV no bundle. Em produção o Elysia omite detalhes de validação nas respostas e
# a documentação Swagger fica desligada.
ENV NODE_ENV=production

# Build API
RUN pnpm build

# Roda sem root: a API só lê os arquivos da imagem.
USER bun

EXPOSE 3001

CMD ["pnpm", "start"]
